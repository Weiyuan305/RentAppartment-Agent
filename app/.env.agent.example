# Server only. Copy to .env.agent.local, fill the three values, then restart.
# Use the provider's /v1 endpoint; the SDK appends /chat/completions.
ATLAS_AI_BASE_URL=
ATLAS_AI_MODEL=
ATLAS_AI_API_KEY=
# Optional: persistent writable path. Back up this file and its WAL together.
ATLAS_CHAT_DB=.data/rental-chat.sqlite
# Maximum AI turns across this server during a rolling 24-hour quota window.
ATLAS_AI_DAILY_LIMIT=100
# Account login (server-only). Generate a random secret of at least 32 characters.
ATLAS_AUTH_SECRET=
# Leave empty locally; Cloudflare uses the fixed public demo origin.
ATLAS_AUTH_URL=
# Optional Google login; both values are server-only OAuth web-client credentials.
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
# Optional server-only TfL application key. Anonymous cloud IPs may be rate limited.
# Register the free product at https://api-portal.tfl.gov.uk/products
ATLAS_TFL_API_KEY=
