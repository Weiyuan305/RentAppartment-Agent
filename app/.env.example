# Current sample: Cesium ion Community evaluation. No automatic provider fallback.
VITE_MAP_PROVIDER=cesium-ion
# Public read-only token, restricted to the Google Photorealistic 3D Tiles asset
# and this app's URL. Do not use tokens with private/write scopes.
VITE_CESIUM_ION_ACCESS_TOKEN=
# Optional later: explicitly set VITE_MAP_PROVIDER=google-maps to use this key.
VITE_GOOGLE_MAPS_API_KEY=
