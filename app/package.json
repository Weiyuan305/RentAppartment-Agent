{
  "name": "campus-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/run-framework.mjs start",
    "build:cloudflare": "node scripts/run-cloudflare.mjs build && node scripts/check-cloudflare-build.mjs",
    "dev:cloudflare": "node scripts/run-cloudflare.mjs dev",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:pages": "node scripts/prepare-pages.mjs && wrangler pages deploy --cwd cloudflare/pages --project-name campus-atlas-demo --branch main --commit-dirty=true && npm run verify:assets",
    "verify:assets": "node scripts/verify-client-assets.mjs",
    "test:assets": "node --test tests/pages-assets.test.mjs tests/client-assets.test.mjs",
    "test:assets:runtime": "node --test tests/pages-assets-runtime.test.mjs",
    "secrets:cloudflare": "node scripts/cloudflare-secrets.mjs",
    "db:cloudflare:local": "wrangler d1 migrations apply ATLAS_DB --local --config cloudflare/wrangler.jsonc --persist-to .wrangler/state",
    "db:cloudflare:remote": "wrangler d1 migrations apply ATLAS_DB --remote --config cloudflare/wrangler.jsonc",
    "test:d1": "node --import tsx --test tests/d1-store.test.ts",
    "test:agent": "node --import tsx --test tests/agent.test.ts tests/model-recovery.test.ts tests/chat-connection.test.ts",
    "test:agent:worker": "node --import tsx --test tests/model-recovery-worker.test.ts",
    "test:markdown": "node --import tsx --test tests/assistant-markdown.test.tsx",
    "test:health": "node --import tsx --test tests/health.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "predev": "node scripts/prepare-cesium.mjs",
    "prebuild": "node scripts/prepare-cesium.mjs",
    "test:sample": "node --import tsx scripts/validate-sample.mjs",
    "test:routes": "node scripts/validate-walking-routes.mjs",
    "collect:routes": "node scripts/collect-walking-routes.mjs",
    "collect:amenities": "node scripts/collect-amenities.mjs",
    "test:amenities": "node scripts/validate-amenities.mjs",
    "typecheck": "tsc --noEmit",
    "check:map": "node scripts/check-map.mjs",
    "test:amenity-routes": "node --import tsx scripts/validate-amenity-routes.mjs",
    "test:auth": "node --import tsx --test tests/auth.test.ts tests/auth-google.test.ts",
    "test:student": "node --import tsx --test tests/student-planner.test.ts tests/student-agent.test.ts",
    "collect:campus": "python3 scripts/collect-campus-catalog.py && node --import tsx scripts/collect-campus-planner.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/react": "4.0.139",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@streamdown/cjk": "1.0.4",
    "ai": "7.0.136",
    "better-auth": "^1.7.7",
    "cesium": "^1.145.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.4",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
